{
  "name": "cdigruttola/gshoppingflux",
  "description": "Export your products to Google Merchant Center, easily.",
  "authors": [
    {
      "name": "cdigruttola",
      "email": "c.digruttola@hotmail.it"
    }
  ],
  "require": {
    "php": ">=8.1",
    "vitalybaev/google-merchant-feed": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "cdigruttola\\GShoppingFlux\\": "src/"
    },
    "classmap": [
      "gshoppingflux.php"
    ],
    "exclude-from-classmap": []
  },
  "config": {
    "preferred-install": "dist",
    "prepend-autoloader": false,
    "platform": {
      "php": "8.1"
    }
  },
  "type": "prestashop-module",
  "author": "cdigruttola"
}
